{
  "name": "chess-progress-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/verify-assets.mjs && node scripts/prepare-source.mjs && vite build && node scripts/harden-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm build",
    "licenses": "node scripts/collect-licenses.mjs",
    "validate:tactics": "node scripts/validate-tactics.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.8",
    "react-chessboard": "5.12.1",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.4.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
